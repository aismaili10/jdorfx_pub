#!/usr/bin/env rexx
parse source . . thisFileName
thisPgmName=filespec('Name',thisFileName)

/* needs ooRexx 5.2.0 ! */
commands=.file~readLines(.sysCargs[1])

   -- create JDORFX handler
jfxdh=.bsf~new("org.oorexx.handlers.jdorfx.JavaFXDrawingHandler")
   -- define "JDORFX" address environment serviced by our JDOR handler
call BsfCommandHandler "add", "JDORFX", jfxdh -- add command handler
useRedirection? = .true
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

say "-- replaying JDORFX commands from:" .sysCargs[1]
do counter c cmd over commands
   say "--" c~right(3)":" cmd
   cmd
end


::requires "BSF.CLS"    -- get ooRexx-Java bridge, contains JDOR Rexx command handler
