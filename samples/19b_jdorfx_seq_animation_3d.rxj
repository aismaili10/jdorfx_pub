/* ========================================================================
   JDORFX Animation Example: Sequential Animation - 3D
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example: Sequential Animation"
newimage 500 500
winTitle "JDORFX Animation - Sequential Animation"

background 

-- create 3D shape (Box)
shape3d rockBox box 250 250 "-500" 30 30 30
fill3dShape rockBox


-- create new material named rock
material rock
-- add image with pathname "rock_diffuse.jpg" as diffuse map to material rock
materialmap rock diffuse "rock_diffuse.jpg"
-- add material rock to rockBox
setmaterial rockBox rock

-- Create rotation animation
-- Parameters: animName, nodeName, duration, byAngle, [cycleCount, autoReverse ,
--              pivotX, pivotY, pivotZ]
animationRotate rotateAnim rockBox 1000 360 "2" .false 1 1 1
animationRotate rotateAnim2 rockBox 1000 360 "2" .false 1 0 1

-- Create translation animation
-- Parameters: animName, nodeName, duration, byX, byY, byZ, ,
--              [cycleCount, autoReverse]
animationTranslate translateAnim rockBox 1000 0 100 500 "1" .false

animationTranslate translateAnim2 rockBox 1000 200 0 0 "1" .false
animationTranslate translateAnim3 rockBox 1000 0 100 0 "1" .false
animationTranslate translateAnim4 rockBox 1000 "-400" "-400" 200 "1" .false

-- Create sequential animation
-- Parameters: animName, nodeName, [anim1, anim2, ...] [cycleCount, autoReverse]
animationSequential seqAnim rotateAnim translateAnim translateAnim2 ,
                        translateAnim3 translateAnim4 rotateAnim2 "-1" .true

-- play animation
animationPlay seqAnim

-- create perspective camera and add to scene
camera camera perspective 0 0 0
setcamera camera

winShow

say "Box animation sequential ..."
say "Press Enter to exit..."
pull .

animationStop seqAnim

say "Animation completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
