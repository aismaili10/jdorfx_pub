/* ========================================================================
   JDORFX Image Example: Drawing Images
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
useRedirection? = .true
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

newimage 600 300
winTitle "JDORFX Image - drawImage Overloads"

-- Load and register the source image.
-- Parameters: imageName, pathName
loadImage OOREXX_LOGO "../oorexx_256.png"

-- Draw the image at its original size.
moveTo 0 0
drawImage OOREXX_LOGO

-- Draw a scaled image on a white background.
-- Parameters: imageName, width, height, [backgroundColor]
moveTo 270 0
drawImage OOREXX_LOGO 128 128 WHITE

-- Draw a scaled section of the source image.
-- Parameters: imageName, width, height, sourceX, sourceY,
--             sourceWidth, sourceHeight, [backgroundColor]
-- moveTo 410 0
-- drawImage OOREXX_LOGO 128 128 64 64 192 192 WHITE

winShow
say "-- Three drawImage variants are displayed. Press Enter to exit."
if useRedirection? then
    sleep 5
else
    pull .
winClose

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "../jdorfx.cls"
