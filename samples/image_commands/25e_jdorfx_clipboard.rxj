/* ========================================================================
   JDORFX Image Example: Clipboard Operations
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
useRedirection? = .true
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

-- Create a partly transparent image.
newimage 40 30
color RED
moveTo 0 0
fillRect 20 30

-- Copy the current image to the system clipboard.
setClipboard
setImage = rc
say "-- Set image dimensions:" setImage~getWidth setImage~getHeight

-- Read the clipboard image and register it as COPIED_IMAGE.
getClipboard COPIED_IMAGE
clipboardImage = rc
imageSize COPIED_IMAGE
say "-- Retrieved image dimensions:" rc

-- Copy an opaque version of the registered image to the clipboard.
setClipboardWithoutAlpha COPIED_IMAGE
opaqueImage = rc
say "-- Opaque image has alpha:" opaqueImage~getColorModel~hasAlpha

-- The clipboard aliases use CLIPBOARD as the default registry name.
clipboardGet
imageSize CLIPBOARD
say "-- Default clipboard registry dimensions:" rc

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "../jdorfx.cls"
