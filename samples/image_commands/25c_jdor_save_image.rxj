/* ========================================================================
   JDOR Image Example: Saving an Image
   ======================================================================== */

-- create JDOR handler
jdor = .bsf~new("org.oorexx.handlers.jdor.JavaDrawingHandler")
-- add the Java Rexx command handler, using default name: JDOR
call BsfCommandHandler "add", "JDOR", jdor
-- set default environment to JDOR
address jdor

-- Create a small red image.
newimage 64 48
color RED
moveTo 0 0
fillRect 64 48

-- Save the current image in the format inferred from the file extension.
-- Parameters: pathName
saveImage "25c_jdor_saved_image.png"
say "Image saved:" rc

exit 0

-- get ooRexx-Java bridge
::requires "BSF.CLS"
