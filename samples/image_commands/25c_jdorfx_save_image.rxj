/* ========================================================================
   JDORFX Image Example: Saving an Image
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

-- Create a small red image.
newimage 64 48
color RED
moveTo 0 0
fillRect 64 48

-- Save the current image in the format inferred from the file extension.
-- Parameters: pathName
saveImage "25c_jdorfx_saved_image.png"
say "Image saved:" rc

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "../jdorfx.cls"
