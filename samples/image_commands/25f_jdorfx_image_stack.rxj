/* ========================================================================
   JDORFX Image Example: Image Stack
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
useRedirection? = arg()>0  -- if any command line argument given, use redirection
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

-- Create a red image.
newimage 20 10
color RED
moveTo 0 0
fillRect 20 10

-- Push a snapshot and also register it as SAVED_RED.
pushImage SAVED_RED
pushedImage = rc
say "-- Pushed image dimensions:" pushedImage~getWidth pushedImage~getHeight
imageSize SAVED_RED
say "-- Registered pushed image dimensions:" rc

-- Cover the current image with blue.
color BLUE
moveTo 0 0
fillRect 20 10

-- Pop the red snapshot and composite it back onto the current image.
popImage
poppedImage = rc
image
currentImage = rc
say "-- Popped image dimensions:" poppedImage~getWidth poppedImage~getHeight
say "-- Popped image pixel:" poppedImage~getRGB(0, 0)
say "-- Current image pixel after pop:" currentImage~getRGB(0, 0)

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
