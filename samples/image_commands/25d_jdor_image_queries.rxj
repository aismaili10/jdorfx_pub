/* ========================================================================
   JDOR Image Example: Querying and Copying Images
   ======================================================================== */

-- create JDOR handler
jdor = .bsf~new("org.oorexx.handlers.jdor.JavaDrawingHandler")
-- add the Java Rexx command handler, using default name: JDOR
call BsfCommandHandler "add", "JDOR", jdor
-- set default environment to JDOR
address jdor

-- Query the dimensions of the current image.
newimage 80 60
imageSize
say "Current image dimensions:" rc

-- Return the current image as a BufferedImage.
image
currentImage = rc
say "Current BufferedImage dimensions:" currentImage~getWidth currentImage~getHeight

-- Query a registered image.
loadImage OOREXX_LOGO "../oorexx_256.png"
image OOREXX_LOGO
logoImage = rc
imageSize OOREXX_LOGO
say "Registered image dimensions:" rc

-- Copy the registered image and query the Rexx variable containing the copy.
imageCopy OOREXX_LOGO
logoCopy = rc
imageSize "logoCopy"
say "Copied Rexx-variable image dimensions:" rc

-- Copy the image
-- imageCopy OOREXX_LOGO WHITE -- no background color supported in JDOR
-- flattenedCopy = rc
-- imageSize "flattenedCopy"
-- say "Background copy dimensions:" rc
-- returns error with background color, 
-- because JDOR does not support background color in imageCopy command

exit 0

-- get ooRexx-Java bridge
::requires "BSF.CLS"
