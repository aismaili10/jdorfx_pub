/* ========================================================================
   JDORFX Animation Example: Rotating & Fading Rectangle
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
useRedirection? = .true
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

say "-- Example: Rotating Rectangle"
newImage 600 600
winTitle "JDORFX Animation - Rectangle Rotation & Fade"

-- Create a rectangle
color BLACK
shape rect RECT 200 200 200 150
fillShape rect

-- Create rotation animation
-- Parameters: animName, nodeName, duration, byValue, cycleCount, autoReverse
animationRotate rotateAnim rect 2000 360*10 "-1" .FALSE

-- Create fade animation
-- Parameters: 
--   animName, nodeName, duration, fromValue, toValue, cycleCount, autoReverse
animationFade fadeAnim rect 500 1 0.3 "-1" .true

-- Play created animations
animationPlay rotateAnim
animationPlay fadeAnim

winShow

say "-- Rectangle rotating ..."

say "-- Press Enter to exit..."
if useRedirection? then
    sleep 5
else
    pull .

animationStop rotateAnim
animationStop fadeAnim

winClose

say "-- Animation completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
