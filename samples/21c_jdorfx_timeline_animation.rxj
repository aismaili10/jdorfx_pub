/* ========================================================================
   JDORFX Animation Example: Timeline + KeyFrame + KeyValue: two objects
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example: Timeline / KeyFrame / KeyValue demo"

newimage 600 500
winTitle "JDORFX Animation - Timeline KeyFrame KeyValue Demo"

-- Draw a 2D shape we can animate
color red
shape myEllipse ellipse 50 170 75 75
fillshape myEllipse

color blue
shape myRect rect 50 300 75 75
fillshape myRect

-- Create a timeline:
-- Parameters: name, cycleCount, autoReverse
timeline myTimeline "-1" .false

-- Create reusable KeyValue for opacity
keyValue fadeKV myEllipse.opacity 0.20 LINEAR
keyValue fadeKV2 myEllipse.opacity 1.0 LINEAR

keyValue fadeKV3 myRect.opacity 0.20 LINEAR
keyValue fadeKV4 myRect.opacity 1.0 LINEAR


-- Add keyframes
keyframe myTimeline 1000 fadeKV
keyframe myTimeline 2000 fadeKV2
keyframe myTimeline 3000 fadeKV
keyframe myTimeline 4000 fadeKV2

keyframe myTimeline 1000 fadeKV3
keyframe myTimeline 2000 fadeKV4
keyframe myTimeline 3000 fadeKV3
keyframe myTimeline 4000 fadeKV4


-- Animate movement on X at the same timeline moments
keyframe myTimeline 2000 myEllipse.translateX 400 LINEAR
keyframe myTimeline 4000 myEllipse.translateX 0 LINEAR

keyframe myTimeline 2000 myRect.translateX 400 LINEAR
keyframe myTimeline 4000 myRect.translateX 0 LINEAR

-- Play timeline
animationPlay myTimeline

winshow

say "Timeline demo is running..."
say "Press Enter to stop animation and exit..."
pull .

animationStop myTimeline

winClose

say "Timeline demo completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
