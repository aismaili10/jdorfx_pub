#!/usr/bin/env rexx
/* ========================================================================
   JDORFX Animation Example: Fast Blinking Effect
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example 4: Fast Blinking Effect"
newImage 600 600

-- Create a square
color orange
shape blinkSquare RECT 250 250 100 100
fillShape blinkSquare

-- Create fast blink animation
-- Short duration (500ms) creates rapid blinking effect
animationFade blinkAnim blinkSquare 500 0.0 1.0 10 .true
animationPlay blinkAnim

winTitle "JDORFX Animation - Blinking Square"
winshow 

say "Square blinking rapidly..."
say "Press Enter to stop and exit..."
pull .

animationStop blinkAnim
winClose

say "Animation completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
