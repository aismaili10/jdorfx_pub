/* ========================================================================
   JDORFX Animation Example: Shape3D Face Culling
   ======================================================================== */
-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

newimage 600 400 .true
background lightblue
shape3d leftBox box 190 200 500 180 180 180
shape3d rightBox box 410 200 500 180 180 180

-- Set or query the face-culling mode.
-- Parameters: shapeName, [NONE | BACK | FRONT]
cullFace leftBox BACK
cullFace rightBox FRONT
-- Query both current modes.
cullFace leftBox
cullFace rightBox
fillshape3d leftBox
fillshape3d rightBox
camera view perspective 0 0 0 45
setCamera view

winTitle "CullFace: BACK (left), FRONT (right)"
winShow
say "The boxes use different face-culling modes. Press Enter."
pull .
winClose

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
