#!/usr/bin/env rexx
/* ========================================================================
   JDORFX Animation Example: Fill Transition on Rectangle
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example: Rotating Rectangle"
winShow
winSize 600 600
winTitle "JDORFX Animation - Rectangle Fill"

-- Create a rectangle
color blue
shape rect RECT 200 200 200 150
fillShape rect

-- Create rotation animation
-- Parameters: animName, nodeName, duration, byValue, cycleCount, autoReverse
-- animationRotate rotateAnim rect 3000 360 "-1" .true

-- Create fill animation
-- Parameters: animName, nodeName, duration, fromValue, toValue, cycleCount, autoReverse
animationFill fillAnim rect 500 red blue "-1" .false

-- Play created animations
-- animationPlay rotateAnim
animationPlay fillAnim

say "Rectangle fill transition ..."
say "Press Enter to exit..."
pull .

winClose

say "Animation completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
