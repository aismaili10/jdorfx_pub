#!/usr/bin/env rexx
/* ========================================================================
   JDORFX Animation Example: Animation Control Demo
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example 5: Animation Control (Play, Pause, Stop)"
newImage 600 600
winTitle "JDORFX Animation - Animation Control"

-- Create a shape
color red
shape controlShape ELLI 250 250 120 120
fillShape controlShape

-- Create fade animation
animationFade controlAnim controlShape 2000 0.2 1.0 10 .true
animationPlay controlAnim

winShow

say "Animation playing..."
say "Press Enter to PAUSE the animation..."
pull .

animationPause controlAnim
say "Animation paused."
say "Press Enter to RESUME the animation..."
pull .

animationPlay controlAnim
say "Animation resumed."
say "Press Enter to STOP the animation..."
pull .

animationStop controlAnim
say "Animation stopped."
say "Press Enter to exit..."
pull .

winClose

say "Animation control demo completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
