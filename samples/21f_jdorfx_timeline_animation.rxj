/* ========================================================================
   JDORFX Animation Example: Timeline + KeyFrame + KeyValue: 
        loading indicator 3
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example: Timeline / KeyFrame / KeyValue demo"

newimage 400 400
winTitle "JDORFX Animation - Timeline KeyFrame KeyValue Demo"

background gray

-- Draw a 2D shape we can animate
color blue
shape rect1 rectangle 175 175 50 50
shape rect2 rectangle 175 175 50 50
fillshape rect1
drawshape rect2

-- timeline
timeline loadingTimeline "-1" .false

-- Add keyframes
keyframe loadingTimeline 400 rect1.scaleX 0.0 LINEAR
keyframe loadingTimeline 400 rect1.scaleY 0.0 LINEAR
keyframe loadingTimeline 3000 rect1.scaleX 1.0 LINEAR
keyframe loadingTimeline 3000 rect1.scaleY 1.0 LINEAR

keyframe loadingTimeline 1000 rect2.rotate 90 LINEAR

winshow

animationPlay loadingTimeline

say "Timeline demo is running..."
say "Press Enter to stop animation and exit..."
pull .

animationStop loadingTimeline

winClose

say "Timeline demo completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
