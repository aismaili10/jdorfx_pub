/* ========================================================================
   JDORFX Animation Example: Camera Rotation
   ======================================================================== */
-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

newimage 600 400 .true
background lightblue

shape3d leftBox box 180 200 500 100 180 100
shape3d rightBox box 420 200 800 100 180 100
fillshape3d leftBox
fillshape3d rightBox

-- Create and activate a perspective camera.
-- Parameters: name, type, x, y, z, fieldOfView
camera view perspective 0 0 0 45
setCamera view

winTitle "rotateCamera"
winShow

do i = 1 to 5
  -- Parameters: cameraName, angle, pivotX, pivotY, pivotZ,
  --             axisX, axisY, axisZ
  rotateCamera view 12 0 0 0 0 1 0
  say "The camera is rotated 12 degrees around Y. Press Enter to continue."
  pull .
end

say "The camera rotation is complete. Press Enter to close."
pull .
winClose

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
