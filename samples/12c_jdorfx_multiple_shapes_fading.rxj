/* ========================================================================
   JDORFX Animation Example: Multiple Fading Shapes
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example: Multiple Fading Shapes"
newimage 600 600
winTitle "JDORFX Animation - Multiple Fading Shapes"

-- Create first shape
color yellow
shape shape1 ELLI 150 130 100 140
fillShape shape1

-- Create second shape
color green
shape shape2 RECT 350 150 100 100
fillShape shape2

-- Create third shape
color blue
shape shape3 ELLI 250 400 70 70
fillShape shape3


-- Create different fade animations for each
-- Each has different duration and opacity range
animationFade fade1 shape1 1500 0.5 1.0 10 .true
animationFade fade2 shape2 2000 1.0 0.3 10 .true
animationFade fade3 shape3 500 0.2 1.0 10 .true

-- Play all animations simultaneously
animationPlay fade1
animationPlay fade2
animationPlay fade3

winShow

say "Three shapes fading at different rates..."
say "Press Enter to stop and exit..."
pull .

-- Stop all animations
animationStop fade1
animationStop fade2
animationStop fade3
winClose

say "Animation completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
