/* ========================================================================
   JDORFX Animation Example: Timeline + KeyFrame + KeyValue: 
        solar eclipse - earth view
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
useRedirection? = arg()>0  -- if any command line argument given, use redirection
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

say "-- Example: Timeline / KeyFrame / KeyValue demo"

newimage 600 400 .true
winTitle "JDORFX Animation - Timeline KeyFrame KeyValue Demo"

background black

-- create stars in the background
do i = 1 to 100
   shape3d star || i sphere random(-4000, 5000) random(-3000, 4000) 10000 30
   fill3dShape star || i
end

-- Create 3D shapes
shape3d moon sphere 150 200 50 50
shape3d sun sphere 300 200 7000 500

fillshape3D moon
fillshape3D sun

-- create materials
material moonMat
materialmap moonMat diffuse "moonmap4k.jpg"
setmaterial moon moonMat

material sunMat
materialmap sunMat selfIllumination "sun_2k.jpg"
materialmap sunMat diffuse "sun_2k.jpg"
setmaterial sun sunMat

-- timeline
timeline moonTimeline "-1" .true

-- Add keyframes
-- spline interpolator for slower middle movement
keyValue timelineKV1 moon translateX 450 "SPLINE(0.30,0.80,0.70,0.20)"
keyframe moonTimeline 6000 timelineKV1


camera myCamera perspective 0 0 0
setCamera myCamera

light sunLight point 300 200 6800 yellow
setLight sunLight

-- light supportLightAbove point 300 0 0 white
-- setLight supportLightAbove

-- light supportLightBelow point 300 400 0 white
-- setLight supportLightBelow

-- light supportLightRight point 100 200 0 white
-- setLight supportLightRight

-- light supportLightLeft point 500 200 0 white
-- setLight supportLightLeft

winshow

animationPlay moonTimeline

say "-- Timeline demo is running..."
say "-- Press Enter to stop animation and exit..."
if useRedirection? then
    sleep 5
else
    pull .

animationStop moonTimeline

winClose

say "-- Timeline demo completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
