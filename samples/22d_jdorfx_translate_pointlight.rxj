/* ========================================================================
   JDORFX Animation Example: PointLight Translation
   ======================================================================== */
-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

newimage 600 400 .true
background black
shape3d target sphere 300 200 500 120
fillshape3d target

-- Create and add a white PointLight.
-- Parameters: name, type, x, y, z, color
light lamp point 120 200 200 white
setLight lamp

-- Create and activate a perspective camera.
-- Parameters: name, type, x, y, z, fieldOfView
camera view perspective 0 0 0 45
setCamera view
winShow

sleep 5
-- Move the light to the right.
-- Parameters: lightName, translateX, translateY, translateZ
translatePointLight lamp 260 0 0

winTitle "translatePointLight lamp 260 0 0"
say "The translated light illuminates the sphere from the right. Press Enter."
pull .
winClose

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
