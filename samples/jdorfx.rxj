#!/usr/bin/env rexx
/*
   Name:    "jdorfx.rxj"
   Invoke:  "rexx jdorfx.rxj < file.txt" (Linux, Windows)
            "rexxj.sh jdorfx.rxj < file.txt" (macOS)
                or via a pipe, e.g. process JDORFX commands from another program
            "python3 testjdorfx.py | rexx jdorfx.rxj"     (Linux, Windows)
            "python3 testjdorfx.py | rexxj.sh jdorfx.rxj" (macOS)

            ? ... optional argument, if supplied displays processed JDOR commands

   Purpose:  Read JDORFX commands from stdin and process them

   Needs:    ooRexx 5.0 or higher:
             BSF4ooRexx850:
             Java/OpenJDK, e.g.:

   Date:    2023-05-30

   Author:  Rony G. Flatscher, WU Vienna

   Changes: 2023-05-31 - check for existence of stdin data, available when
                         redirected file or pipe that feeds stdin
            2023-06-01 - allow for directly supplying filename that contains JDOR commands
                         (will have precedence over redirection of stdin)



   last change: Revision: $Revision: 951 $ $Author: orexx $ $Date: 2022-08-10 18:06:25 +0200 (Mi., 10 Aug 2022) $
                (svn hint: use 'propset svn:keywords "Author Date Revision" filename')

   license:

    ------------------------ Apache Version 2.0 license -------------------------
       Copyright (C) 2023 Rony G. Flatscher

       Licensed under the Apache License, Version 2.0 (the "License");
       you may not use this file except in compliance with the License.
       You may obtain a copy of the License at

           http://www.apache.org/licenses/LICENSE-2.0

       Unless required by applicable law or agreed to in writing, software
       distributed under the License is distributed on an "AS IS" BASIS,
       WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
       See the License for the specific language governing permissions and
       limitations under the License.
    -----------------------------------------------------------------------------
*/
parse source . . thisFileName
thisPgmName=filespec('Name',thisFileName)

bShowCommands=.false    -- by default do not show JDOR commands (in canonical form)
s=.stdin                -- default to stdin
   -- runJDORcommands.rxj [file.txt] [?] | < file.txt [?]
if arg()>0 then      -- arguments given: an optional filename and/or a trailing ? (asterisk)
do
   if .sysCargs~items>2 then exit -1      -- indicate that too many arguments
   bShowCommands=.sysCargs~lastItem='?'   -- show JDOR commands in canonical form?
   if (bShowCommands & .sysCargs~items=2) | (\bShowCommands & .sysCargs~items=1) then
   do
      s=.stream~new(.sysCargs[1])~~open("read") -- read commands from file
   end
   else if \bShowCommands & .sysCargs~items>1 then
      exit -2   -- indicate too many arguments
end
   -- create JDORFX handler
-- jfxdh=.bsf~new("org.oorexx.handlers.jdorfx.JavaFXDrawingHandler")
--    -- define "JDORFX" address environment serviced by our JDORFX handler
-- call BsfCommandHandler "add", "JDORFX", jfxdh -- add command handler
call addJdorFXHandler
address jdorfx
if s~state="READY" then
do
    if s~chars=0 then   -- no data to read
    do
        .error~say(thisPgmName": no data to read: is stdin redirected or a text file with commands supplied?")
        exit -10        -- indicate error
    end
   -- set default environment to JDORFX
   --    if "using output": JDORFX commands get displayed in canonical form
   --    if "using error" : JDORFX commands with errors get displayed with error information
   if bShowCommands then
      -- redirect output (show canonical JDORFX commands):
      address jdorfx with input using (s) output using (.stdout) error using (.stderr)
   else
      address jdorfx with input using (s) error using (.stderr)

   "-- a JDORFX comment (by "thisPgmName") to trigger the command handler so that it reads redirected input"

   -- winShow is asynchronous. Keep the Rexx process alive long enough to see
   -- windows created by short-lived generators such as testjdorfx.py.
   call SysSleep 10
   exit 0
end
exit -11    -- indicate state is NOTREADY

::requires "jdorfx.cls"    -- get ooRexx-Java bridge, contains JDORFX Rexx command handler
