/* ========================================================================
   Oracle JavaFX 8 Animation Basics, Example 3-2: Path Transition
   JDORFX equivalent
   ======================================================================== */

-- Load and register the Java Rexx command handler under its default name JDORFX.
call addJdorFXHandler
-- Send the following graphics commands to the JDORFX handler.
useRedirection? = arg()>0  -- if any command line argument given, use redirection
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

say "-- Oracle Example 3-2: Path Transition"
-- Create a 420 x 280 drawing surface, set its title, and paint it white.
newimage 420 280
winTitle "Oracle JavaFX 8 - Path Transition (JDORFX)"
background white

-- Create the path from Oracle Example 3-2.
-- shape path parameters: name, PATH, windingRule (1 means non-zero)
color lightgray
shape path path 1
-- Start the path at (20,20).
pathMoveTo path 20 20
-- pathCurveTo parameters: pathName, controlX1, controlY1,
--                         controlX2, controlY2, endX, endY
pathCurveTo path 380 0 380 120 200 120
pathCurveTo path 0 120 0 240 380 240
-- Draw the path using the current light-gray color.
drawshape path

-- Create and fill the rounded rectangle that follows the path.
color orange
shape rectPath roundrect 0 0 40 40 10 10
fillshape rectPath

-- Create the path transition.
-- Parameters: animName, nodeName, durationMs, pathName,
--             cycleCount (-1 means indefinite), autoReverse, orientation
animationPath pathTransition rectPath 4000 path "-1" .true ORTHOGONAL_TO_TANGENT
animationPlay pathTransition

-- Display the window and keep the Rexx program alive until Enter is pressed.
winshow
say "-- Press Enter to stop and exit..."
if useRedirection? then
    sleep 5
else
    pull .
animationStop pathTransition
winclose
exit 0

-- Load the ooRexx-Java bridge from the parent samples directory.
::requires "../jdorfx.cls"
