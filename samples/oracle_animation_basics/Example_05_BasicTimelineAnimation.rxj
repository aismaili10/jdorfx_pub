/* ========================================================================
   Oracle JavaFX 8 Animation Basics, Example 3-5: Basic Timeline Animation
   JDORFX equivalent
   ======================================================================== */

-- Load and register the Java Rexx command handler under its default name JDORFX.
call addJdorFXHandler
-- Send the following graphics commands to the JDORFX handler.
useRedirection? = arg()>0  -- if any command line argument given, use redirection
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

say "-- Oracle Example 3-5: Basic Timeline"
-- Create the drawing surface and configure its window and background.
newimage 520 180
winTitle "Oracle JavaFX 8 - Basic Timeline (JDORFX)"
background white

-- Create and fill the rectangle animated by the timeline.
-- shape parameters: name, type, x, y, width, height
color red
shape rectBasicTimeline rect 100 50 100 50
fillshape rectBasicTimeline

-- Create a timeline that repeats indefinitely and reverses after each cycle.
-- Parameters: timelineName, cycleCount (-1 means indefinite), autoReverse
timeline basicTimeline "-1" .true
-- Add a keyframe reached after 500 ms.
-- First create a named KeyValue, then add it to the timeline.
keyValue timelineKV1 rectBasicTimeline x 300
keyframe basicTimeline 500 timelineKV1
-- Timelines use the same animationPlay/animationStop controls as transitions.
animationPlay basicTimeline

-- Display the window and keep the Rexx program alive until Enter is pressed.
winshow
say "-- Press Enter to stop and exit..."
if useRedirection? then
    sleep 5
else
    pull .
animationStop basicTimeline
winclose
exit 0

-- Load the ooRexx-Java bridge from the parent samples directory.
::requires "../jdorfx.cls"
