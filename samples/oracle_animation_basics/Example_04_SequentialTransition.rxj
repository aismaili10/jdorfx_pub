/* ========================================================================
   Oracle JavaFX 8 Animation Basics, Example 3-4: Sequential Transition
   JDORFX equivalent
   ======================================================================== */

-- Load and register the Java Rexx command handler under its default name JDORFX.
call addJdorFXHandler
-- Send the following graphics commands to the JDORFX handler.
useRedirection? = arg()>0  -- if any command line argument given, use redirection
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

say "-- Oracle Example 3-4: Sequential Transition"
-- Create the drawing surface and configure its window and background.
newimage 520 300
winTitle "Oracle JavaFX 8 - Sequential Transition (JDORFX)"
background white

-- Create Oracle s rounded crimson rectangle. Its coordinates include the
-- original JavaFX translateX=50 and translateY=50 starting offsets.
color crimson
shape rectSeq roundrect 75 75 50 50 15 15
fillshape rectSeq

-- Define the four child transitions without playing them separately.
-- Fade parameters: name, node, durationMs, fromOpacity, toOpacity,
--                  cycleCount, autoReverse
animationFade fadeTransition rectSeq 1000 1.0 0.3 1 .true
-- Translate parameters: name, node, durationMs, byX, byY, byZ,
--                       cycleCount, autoReverse
animationTranslate translateTransition rectSeq 2000 325 0 0 1 .true
-- Rotate parameters: name, node, durationMs, byAngle, cycleCount, autoReverse
animationRotate rotateTransition rectSeq 2000 180 4 .true
-- Scale parameters: name, node, durationMs, byX, byY, byZ,
--                   cycleCount, autoReverse
animationScale scaleTransition rectSeq 2000 1 1 0 1 .true

-- Combine the four children in their execution order. The parent repeats
-- indefinitely and auto-reverses the complete sequence.
animationSequential sequentialTransition fadeTransition translateTransition ,
                    rotateTransition scaleTransition "-1" .true
animationPlay sequentialTransition

-- Display the window and keep the Rexx program alive until Enter is pressed.
winshow
say "-- Press Enter to stop and exit..."
if useRedirection? then
    sleep 5
else
    pull .
animationStop sequentialTransition
winclose
exit 0

-- Load the ooRexx-Java bridge from the parent samples directory.
::requires "../jdorfx.cls"
