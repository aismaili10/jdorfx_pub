#!/usr/bin/env rexx
/* ========================================================================
   JDORFX Animation Example: Translation on Rectangles
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example: Translating"
newimage 500 500
winTitle "JDORFX Animation - 2D Shapes Translation"

color green
shape rect1 ROUNDRECT 25 25 100 100 20 20
fillshape rect1

color orange
shape rect2 ROUNDRECT 50 50 100 100 20 20
fillshape rect2

color blue
shape rect3 ROUNDRECT 75 75 100 100 20 20
fillshape rect3


-- Create translation animation
-- Parameters: animName, nodeName, duration, byX, byY, byZ, cycleCount, autoReverse
animationTranslate translateAnim1 rect1 3000 300 0 0 "-1" .true
animationTranslate translateAnim2 rect2 3000 300 300 0 "-1" .true
animationTranslate translateAnim3 rect3 3000 0 300 0 "-1" .true

-- play animation
animationPlay translateAnim1
animationPlay translateAnim2
animationPlay translateAnim3

winShow


say " translating ..."
say "Press Enter to exit..."
pull .

say "Animation completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
