       limitations under the License.
    -----------------------------------------------------------------------------

*/

say "-- entered program"
-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
say "-- CALLING addJdorFXHandler ..."
call "addJdorFXHandler"
-- set default environment to JDORFX
say "--" SETTING default env to JDORFX
useRedirection? = arg()>0  -- if any command line argument given, use redirection
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

say "-- Create a scene and add 3D shapes"
-- creating a new window with size 500 x 500
newimage 500 500
-- create new sphere with the name "mySphere" at location x=100, y=100, z=0
-- and a radius=50
say "-- Creating new sphere mySphere at (100,100,0) with radius 50"
shape3d mySphere sphere 100 100 0 50
-- create new box with the name "myBox" at location x=400, y=175, z=0
-- and size: width=100, height=250, depth=200
say "-- Creating new box myBox at (400,175,0) with size 100x250x200"
shape3d myBox box 400 175 0 100 250 200
-- create new cylinder with the name "myCylinder" at location x=100, y=350, z=0
-- and size: radius=50, height=150
say "-- Creating new cylinder myCylinder at (100,350,0) with radius 50 and height 150"
shape3d myCylinder cylinder 100 350 0 50 150
-- place mySphere onto scene with filled vertices; also: fillshape3d
say "-- Placing mySphere onto scene with filled vertices"
fill3dshape mySphere
-- place myBox onto scene as line / wireframe model; also: drawshape3d
say "-- Placing myBox onto scene as line / wireframe model"
draw3dshape myBox
-- place myCylinder onto scene with filled vertices; also: fill3dshape
say "-- Placing myCylinder onto scene with filled vertices"
fillshape3d myCylinder
-- show created window
say "-- Showing created window"
winshow
say "-- "
say "-- Sleep for 5 seconds and end program..."
sleep 5

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
