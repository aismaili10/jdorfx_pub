/* ========================================================================
   JDORFX Animation Example: Timeline + KeyFrame + KeyValue: ball slide
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
useRedirection? = .false
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

say "-- Example: Timeline / KeyFrame / KeyValue demo"

newimage 600 500
winTitle "JDORFX Animation - Timeline KeyFrame KeyValue Demo"

-- Draw a 2D shape we can animate
color red
shape myEllipse ellipse 50 170 75 75
fillshape myEllipse

-- Create a timeline:
-- Parameters: name, cycleCount, autoReverse
timeline ballTimeline "-1" .false

-- Create reusable KeyValues and add one KeyValue to each KeyFrame.
keyValue moveForwardKV myEllipse translateX 400 EASE_BOTH
keyValue moveBackKV myEllipse translateX 0 LINEAR
keyframe ballTimeline 5000 moveForwardKV
keyframe ballTimeline 6000 moveBackKV

-- Play timeline
animationPlay ballTimeline

winshow

say "-- Timeline demo is running..."
say "-- Press Enter to stop animation and exit..."
if useRedirection? then
    sleep 15
else
    pull .

animationStop ballTimeline

winClose

say "-- Timeline demo completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
