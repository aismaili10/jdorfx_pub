#!/usr/bin/env rexx
/* ========================================================================
   JDORFX Animation Example: Fading Circle
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example 1: Fading Circle"
winShow
winSize 600 600
winTitle "JDORFX Animation - Fading Circle"

-- Create a circle
color red
shape circle ELLI 150 150 250 250
fillShape circle

-- Create fade animation (fade in and out indefinitely)
-- Parameters: animName, nodeName, duration, fromValue, toValue, cycleCount, autoReverse
animationFade fadeAnim circle 2000 0.1 1.0 10 .true
animationPlay fadeAnim

say "Circle fading in and out..."
say "Press Enter to stop and exit..."
pull .

animationStop fadeAnim
winClose

say "Animation completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
