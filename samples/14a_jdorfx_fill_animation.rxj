/* ========================================================================
   JDORFX Animation Example: Fill Transition on Rectangle
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
useRedirection? = .true
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

say "-- Example: Fill Transition on Rectangle"

newImage 600 600
winTitle "JDORFX Animation - Rectangle Fill"

-- Create a rectangle
color red
shape redRect RECT 200 200 200 150
fillShape redRect

-- Create fill animation
-- Parameters: animName, nodeName, duration, fromValue, toValue,
--               cycleCount, autoReverse
animationFill fillAnim redRect 3000 red blue "-1" .true

-- Play created animations
animationPlay fillAnim

winShow

say "-- Rectangle fill transition ..."
say "-- Press Enter to exit..."
if useRedirection? then
    sleep 5
else
    pull .

animationStop fillAnim

winClose

say "-- Animation completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
