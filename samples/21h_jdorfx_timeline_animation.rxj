/* ========================================================================
   JDORFX Animation Example: Timeline + KeyFrame + KeyValue: 
        loading indicator 5
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
useRedirection? = arg()>0  -- if any command line argument given, use redirection
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

say "-- Example: Timeline / KeyFrame / KeyValue demo"

newimage 400 400
winTitle "JDORFX Animation - Timeline KeyFrame KeyValue Demo"

background gray

-- Draw a 2D shape we can animate
color blue
shape rect1 roundrect 170 170 30 30 10 10
shape rect2 roundrect 170 205 30 30 10 10
shape rect3 roundrect 205 170 30 30 10 10
shape rect4 roundrect 205 205 30 30 10 10
fillshape rect1
fillshape rect2
fillshape rect3
fillshape rect4

-- timeline
timeline loadingTimeline "-1" .false

-- Add keyframes
keyValue timelineKV1 rect1 scaleX 1.20 LINEAR
keyframe loadingTimeline 300 timelineKV1
keyValue timelineKV2 rect1 scaleY 1.20 LINEAR
keyframe loadingTimeline 300 timelineKV2
keyValue timelineKV3 rect1 scaleX 1.0 LINEAR
keyframe loadingTimeline 600 timelineKV3
keyValue timelineKV4 rect1 scaleY 1.0 LINEAR
keyframe loadingTimeline 600 timelineKV4

keyValue timelineKV5 rect3 scaleX 1.0 LINEAR
keyframe loadingTimeline 200 timelineKV5
keyValue timelineKV6 rect3 scaleY 1.0 LINEAR
keyframe loadingTimeline 200 timelineKV6
keyValue timelineKV7 rect3 scaleX 1.20 LINEAR
keyframe loadingTimeline 600 timelineKV7
keyValue timelineKV8 rect3 scaleY 1.20 LINEAR
keyframe loadingTimeline 600 timelineKV8
keyValue timelineKV9 rect3 scaleX 1.0 LINEAR
keyframe loadingTimeline 900 timelineKV9
keyValue timelineKV10 rect3 scaleY 1.0 LINEAR
keyframe loadingTimeline 900 timelineKV10

keyValue timelineKV11 rect4 scaleX 1.0 LINEAR
keyframe loadingTimeline 500 timelineKV11
keyValue timelineKV12 rect4 scaleY 1.0 LINEAR
keyframe loadingTimeline 500 timelineKV12
keyValue timelineKV13 rect4 scaleX 1.20 LINEAR
keyframe loadingTimeline 700 timelineKV13
keyValue timelineKV14 rect4 scaleY 1.20 LINEAR
keyframe loadingTimeline 700 timelineKV14
keyValue timelineKV15 rect4 scaleX 1.0 LINEAR
keyframe loadingTimeline 1000 timelineKV15
keyValue timelineKV16 rect4 scaleY 1.0 LINEAR
keyframe loadingTimeline 1000 timelineKV16

keyValue timelineKV17 rect2 scaleX 1.0 LINEAR
keyframe loadingTimeline 700 timelineKV17
keyValue timelineKV18 rect2 scaleY 1.0 LINEAR
keyframe loadingTimeline 700 timelineKV18
keyValue timelineKV19 rect2 scaleX 1.20 LINEAR
keyframe loadingTimeline 1000 timelineKV19
keyValue timelineKV20 rect2 scaleY 1.20 LINEAR
keyframe loadingTimeline 1000 timelineKV20
keyValue timelineKV21 rect2 scaleX 1.0 LINEAR
keyframe loadingTimeline 1300 timelineKV21
keyValue timelineKV22 rect2 scaleY 1.0 LINEAR
keyframe loadingTimeline 1300 timelineKV22

winshow

animationPlay loadingTimeline

say "-- Timeline demo is running..."
say "-- Press Enter to stop animation and exit..."
if useRedirection? then
    sleep 5
else
    pull .

animationStop loadingTimeline

winClose

say "-- Timeline demo completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
