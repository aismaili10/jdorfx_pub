/* ========================================================================
   JDORFX Animation Example: Timeline + KeyFrame + KeyValue: 
        loading indicator 5
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example: Timeline / KeyFrame / KeyValue demo"

newimage 400 400
winTitle "JDORFX Animation - Timeline KeyFrame KeyValue Demo"

background gray

-- Draw a 2D shape we can animate
color blue
shape rect1 roundrect 170 170 30 30 10 10
shape rect2 roundrect 170 205 30 30 10 10
shape rect3 roundrect 205 170 30 30 10 10
shape rect4 roundrect 205 205 30 30 10 10
fillshape rect1
fillshape rect2
fillshape rect3
fillshape rect4

-- timeline
timeline loadingTimeline "-1" .false

-- Add keyframes
keyframe loadingTimeline 300 rect1.scaleX 1.20 LINEAR
keyframe loadingTimeline 300 rect1.scaleY 1.20 LINEAR
keyframe loadingTimeline 600 rect1.scaleX 1.0 LINEAR
keyframe loadingTimeline 600 rect1.scaleY 1.0 LINEAR

keyframe loadingTimeline 200 rect3.scaleX 1.0 LINEAR
keyframe loadingTimeline 200 rect3.scaleY 1.0 LINEAR
keyframe loadingTimeline 600 rect3.scaleX 1.20 LINEAR
keyframe loadingTimeline 600 rect3.scaleY 1.20 LINEAR
keyframe loadingTimeline 900 rect3.scaleX 1.0 LINEAR
keyframe loadingTimeline 900 rect3.scaleY 1.0 LINEAR

keyframe loadingTimeline 500 rect4.scaleX 1.0 LINEAR
keyframe loadingTimeline 500 rect4.scaleY 1.0 LINEAR
keyframe loadingTimeline 700 rect4.scaleX 1.20 LINEAR
keyframe loadingTimeline 700 rect4.scaleY 1.20 LINEAR
keyframe loadingTimeline 1000 rect4.scaleX 1.0 LINEAR
keyframe loadingTimeline 1000 rect4.scaleY 1.0 LINEAR

keyframe loadingTimeline 700 rect2.scaleX 1.0 LINEAR
keyframe loadingTimeline 700 rect2.scaleY 1.0 LINEAR
keyframe loadingTimeline 1000 rect2.scaleX 1.20 LINEAR
keyframe loadingTimeline 1000 rect2.scaleY 1.20 LINEAR
keyframe loadingTimeline 1300 rect2.scaleX 1.0 LINEAR
keyframe loadingTimeline 1300 rect2.scaleY 1.0 LINEAR

winshow

animationPlay loadingTimeline

say "Timeline demo is running..."
say "Press Enter to stop animation and exit..."
pull .

animationStop loadingTimeline

winClose

say "Timeline demo completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
