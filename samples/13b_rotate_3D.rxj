#!/usr/bin/env rexx
/* ========================================================================
   JDORFX Animation Example: Rotating 3D Box
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example 2: Rotating Box"
newimage 500 500
winTitle "JDORFX Animation - Box Rotation"

-- Create a Box
--color green
shape3d rockBox box 250 250 0 100 100 100
fill3dShape rockBox

-- create new material named rock
-- material rock
-- add image with pathname "rock_diffuse.jpg" as diffuse map to material rock
-- materialmap rock diffuse "rock_diffuse.jpg"
-- add material rock to rockBox
-- setmaterial rockBox rock

material matGreen green
setmaterial rockBox matGreen

-- Create rotation animation
-- Parameters: animName, nodeName, duration, byValue, cycleCount, autoReverse
animationRotate rotateAnim rockBox 3000 360 1 .false 1 0 0
animationRotate rotateAnim2 rockBox 3000 360 1 .false 0 1 0
animationRotate rotateAnim3 rockBox 3000 360 1 .false 0 0 1
animationRotate rotateAnim4 rockBox 3000 360 1 .false 1 1 1

-- create perspective camera and add to scene
camera camera perspective 0 0 0
setcamera camera

winShow

do i = 1 to 4
   -- play animation
   animationPlay rotateAnim
   sleep 4
   animationStop rotateAnim
   animationPlay rotateAnim2
   sleep 4
   animationStop rotateAnim2
   animationPlay rotateAnim3
   sleep 4
   animationStop rotateAnim3
   animationPlay rotateAnim4
   sleep 4
   animationStop rotateAnim4
end

say "Box rotating ..."
say "Press Enter to exit..."
pull .


say "Animation completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
