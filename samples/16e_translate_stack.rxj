#!/usr/bin/env rexx
/* ========================================================================
   JDORFX Animation Example: Translation on 3D Shapes
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx
say "Example: Translating 3D Shapes"
newimage 700 600 .true
winTitle "JDORFX Animation - Translate 3D Shapes (Stacks)"

background gray

-- create a floor
shape3d floor box 350 500 0 1200 30 900
fill3dShape floor

-- create materials
material floorMat
materialmap floorMat diffuse "tiles.jpg"
setmaterial floor floorMat

material boxMat
materialmap boxMat diffuse "fur_bump.jpg"

material cylinderMat
materialmap cylinderMat diffuse "fur_diffuse.jpg"

-- Create a stack of 3D boxes
do i = 1 to 4
   shape3d box || i box 175 "-200" 0 100 100 100
   fill3dShape box || i
   setmaterial box || i boxMat
end

-- Create a stack of 3D cylinders
do i = 1 to 4
   shape3d cylinder || i cylinder 525 "-200" 0 50 100
   fill3dShape cylinder || i
   setmaterial cylinder || i cylinderMat
end

-- create translate animation for the shapes
do i = 1 to 4
    animationTranslate translateAnimBox || i box || i , 
                        3000 0 (735 - (100 * i)) 0 1 .false
    animationTranslate translateAnimCylinder || i cylinder || i ,
                        3000 0 (735 - (100 * i)) 0 1 .false
end

camera camera perspective 0 0 0
setcamera camera

light light1 point 0 0 0 white
setLight light1

light light2 point 700 0 0 white
setLight light2

light light3 point 350 0 "-400" white
setLight light3


winShow

say "Translation demo is running..."

do i = 1 to 4
    animationPlay translateAnimBox || i
    animationPlay translateAnimCylinder || i
    sleep 2
end

say "Translation demo completed!"
say "Press Enter to exit..."
pull .

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
