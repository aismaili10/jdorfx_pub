/* ========================================================================
   JDORFX Animation Example: Timeline + KeyFrame + KeyValue: 
        loading indicator 2
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example: Timeline / KeyFrame / KeyValue demo"

newimage 400 400
winTitle "JDORFX Animation - Timeline KeyFrame KeyValue Demo"

background gray

-- Draw a 2D shape we can animate
color blue
shape rect1 rectangle 170 170 30 30
shape rect2 rectangle 170 205 30 30
shape rect3 rectangle 205 170 30 30
shape rect4 rectangle 205 205 30 30
fillshape rect1
fillshape rect2
fillshape rect3
fillshape rect4

-- timeline
timeline loadingTimeline "-1" .false

-- Add keyframes
keyframe loadingTimeline 1 rect1.scaleX 1.0 LINEAR
keyframe loadingTimeline 300 rect1.scaleX 0.20 LINEAR
keyframe loadingTimeline 600 rect1.scaleX 1.0 LINEAR

keyframe loadingTimeline 150 rect3.scaleY 1.0 LINEAR
keyframe loadingTimeline 450 rect3.scaleY 0.20 LINEAR
keyframe loadingTimeline 750 rect3.scaleY 1.0 LINEAR

keyframe loadingTimeline 300 rect4.scaleX 1.0 LINEAR
keyframe loadingTimeline 600 rect4.scaleX 0.20 LINEAR
keyframe loadingTimeline 900 rect4.scaleX 1.0 LINEAR

keyframe loadingTimeline 450 rect2.scaleY 1.0 LINEAR
keyframe loadingTimeline 750 rect2.scaleY 0.20 LINEAR
keyframe loadingTimeline 1050 rect2.scaleY 1.0 LINEAR

winshow

animationPlay loadingTimeline

say "Timeline demo is running..."
say "Press Enter to stop animation and exit..."
pull .

animationStop loadingTimeline

winClose

say "Timeline demo completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
