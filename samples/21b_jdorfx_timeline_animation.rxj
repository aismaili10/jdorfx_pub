/* ========================================================================
   JDORFX Animation Example: Timeline + KeyFrame + KeyValue: ball slide + fade
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

say "Example: Timeline / KeyFrame / KeyValue demo"

newimage 600 500
winTitle "JDORFX Animation - Timeline KeyFrame KeyValue Demo"

-- Draw a 2D shape we can animate
color red
shape myEllipse ellipse 50 170 75 75
fillshape myEllipse

-- Create a timeline:
-- Parameters: name, cycleCount, autoReverse
timeline ballTimeline "-1" .false

-- Create reusable KeyValue for opacity
keyValue fadeKV myEllipse.opacity 0.20 LINEAR
keyValue fadeKV2 myEllipse.opacity 1.0 LINEAR

-- Add keyframes
keyframe ballTimeline 1000 fadeKV
keyframe ballTimeline 2000 fadeKV2
keyframe ballTimeline 3000 fadeKV
keyframe ballTimeline 4000 fadeKV2

-- Animate movement on X at the same timeline moments
keyframe ballTimeline 2000 myEllipse.translateX 400 LINEAR
keyframe ballTimeline 4000 myEllipse.translateX 0 LINEAR

-- Play timeline
animationPlay ballTimeline

winshow

say "Timeline demo is running..."
say "Press Enter to stop animation and exit..."
pull .

animationStop ballTimeline

winClose

say "Timeline demo completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
