/* ========================================================================
   JDORFX Animation Example: Timeline + KeyFrame + KeyValue: ball slide + fade
   ======================================================================== */


-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
useRedirection? = arg()>0  -- if any command line argument given, use redirection
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

say "-- Example: Timeline / KeyFrame / KeyValue demo"

newimage 600 500
winTitle "JDORFX Animation - Timeline KeyFrame KeyValue Demo"

-- Draw a 2D shape we can animate
color red
shape myEllipse ellipse 50 170 75 75
fillshape myEllipse

-- Create a timeline:
-- Parameters: name, cycleCount, autoReverse
timeline ballTimeline "-1" .false

-- Create reusable KeyValue for opacity
keyValue fadeKV myEllipse opacity 0.20 LINEAR
fadeKVObject = rc
keyValue fadeKV2 myEllipse opacity 1.0 LINEAR
fadeKV2Object = rc

-- Create reusable KeyValues for movement
keyValue moveForwardKV myEllipse translateX 400 LINEAR
moveForwardKVObject = rc
keyValue moveBackKV myEllipse translateX 0 LINEAR
moveBackKVObject = rc

-- A typed Java KeyValue[] lets one KeyFrame change several properties.
valuesAt2000 = bsf.createJavaArrayOf("javafx.animation.KeyValue", fadeKV2Object, moveForwardKVObject)
valuesAt4000 = bsf.createJavaArrayOf("javafx.animation.KeyValue", fadeKV2Object, moveBackKVObject)

-- Add keyframes
keyframe ballTimeline 1000 fadeKV
keyframe ballTimeline 2000 "valuesAt2000"
keyframe ballTimeline 3000 fadeKV
keyframe ballTimeline 4000 "valuesAt4000"

-- Play timeline
animationPlay ballTimeline

winshow

say "-- Timeline demo is running..."
say "-- Press Enter to stop animation and exit..."

if useRedirection? then
    sleep 5
else
    pull .

animationStop ballTimeline

winClose

say "-- Timeline demo completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
