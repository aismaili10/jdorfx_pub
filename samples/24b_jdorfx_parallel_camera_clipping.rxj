/* ========================================================================
   JDORFX Animation Example: Parallel Camera Clipping
   ======================================================================== */
-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

newimage 700 450 .true
background lightblue

-- These boxes are at increasing distances from the camera.
shape3d nearBox box 180 225 100 100 100 100
shape3d visibleBox box 350 225 600 160 160 160
shape3d farBox box 520 225 1500 240 240 240
fillshape3d nearBox
fillshape3d visibleBox
fillshape3d farBox

-- Parallel projection removes perspective size reduction, but its camera
-- still uses near and far clipping planes. Only visibleBox is in range.
-- Parameters: name, type, x, y, z
camera view parallel 0 0 0

-- Set the initial visible depth interval.
-- Parameters: cameraName, distance
cameraNearClip view 0.1
cameraFarClip view 1000
setCamera view

winTitle "ParallelCamera: nearClip=400, farClip=1000"
winShow

sleep 5
say "Changing nearClip to 400 and farClip to 1000. Press Enter."
-- Reuse the same command structure to change both clipping planes.
cameraNearClip view 400
cameraFarClip view 1000

say "Only the middle box is inside the clipping interval. Press Enter."
pull .
winClose

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
