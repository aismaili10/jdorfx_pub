/* ========================================================================
   JDORFX Animation Example: Fully Fading Rectangle
   ======================================================================== */

-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
useRedirection? = arg()>0  -- if any command line argument given, use redirection
if useRedirection? then
    address jdorfx with output using (.stdout) error using (.stderr)
else
    address jdorfx

say "-- Example: Fading Rectangle (Fade Out)"
newImage 600 600
winTitle "JDORFX Animation - Fading Rectangle"

-- Create a rectangle
color green
shape rect RECT 200 200 200 150
fillShape rect

-- Create fade out animation (single run)
-- Parameters:
--   animName, nodeName, duration, fromValue, toValue, cycleCount, autoReverse
animationFade fadeOutAnim rect 5000 1.0 0.0 1 .false
animationPlay fadeOutAnim

winshow

say "-- Rectangle fading out once..."
say "-- Press Enter to exit..."
if useRedirection? then
    sleep 5
else
    pull .

winClose

say "-- Animation completed!"

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
