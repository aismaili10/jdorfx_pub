/* ========================================================================
   JDORFX Animation Example: PointLight and Face Culling
   ======================================================================== */
-- create JDORFX handler
-- load and add the Java Rexx command handler, using default name: JDORFX
call addJdorFXHandler
-- set default environment to JDORFX
address jdorfx

newimage 1000 900 .true
shape3d cube box 250 200 300 160 160 160

-- Parameters: shapeName, [NONE | BACK | FRONT]
cullFace cube FRONT
fillshape3d cube

-- PointLight command structures:
-- light name point x y z [color]
-- translatePointLight lightName translateX translateY translateZ
-- light movingLight point 100 100 (-300) white
-- translatePointLight movingLight 50 0 0
-- setLight movingLight

-- Parameters: name, type, x, y, z, [fieldOfView]
camera view perspective 0 0 0
setCamera view
winTitle "JDORFX PointLight and CullFace"
winShow
sleep 4
winClose

exit 0

-- get ooRexx-Java bridge, contains JDORFX Rexx command handler
::requires "jdorfx.cls"
